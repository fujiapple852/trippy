@locale zh-TW
---

trippy = trippy v{$version}
auto = 自動
on = 開
off = 關
yes = 是
no = 否
none = 無
hidden = **隱藏**
target = {#b}目標:{/b} {$source} -> {$dest}
status = {#b}狀態:{/b} {$status}，{$discovered}
privileged = 特權
unprivileged = 非特權
na = 不適用
discovered = 發現 {$hop_count :integer} 跳
discovered_flows = 發現 {$hop_count :integer} 跳和 {$flow_count :integer} 條不同的流
unknown = 未知
icmp = icmp
udp = udp
tcp = tcp
status_failures = {$status} [共 {$total_probes :integer} \
  個探測，{$failure_count :integer} \
  個失敗（{$failure_rate :percent minimumFractionDigits=1 maximumFractionDigits=1}）❗]
status_failed = 失敗
status_running = 執行中
status_frozen = 凍結 ({$duration})
awaiting_data = 等待資料……

header_help =
  .input {$key :string}
  .match $key
  * {{[{#key}{$key}{/key}] 說明}}

header_settings =
  .input {$key :string}
  .match $key
  * {{[{#key}{$key}{/key}] 設定}}

header_quit =
  .input {$key :string}
  .match $key
  * {{[{#key}{$key}{/key}] 結束}}

title_hops = 跳
title_frequency = 頻率 #{$ttl}
title_samples = 樣本 #{$ttl}
title_traces = 追蹤
title_flows = 流
title_map = 地圖
title_help = 說明
title_settings = 設定
bsod_failed = Trippy 失敗 :(
bsod_quit = 按 [{#key}{$key}{/key}] 結束
hop = 第 {$ttl} 跳
rtt = 往返時間
title_chart = 圖表
samples = 樣本
host = 主機: {$hosts}
no_response = 無回應
dns_failed = 失敗: {$ip}
dns_timeout = 逾時: {$ip}
labels = 標籤: {$labels}
not_enabled = 未啟用
not_found = 未找到
awaited = 等待中
as_name = AS 名稱: {$value}
as_info = AS 資訊: {$value}
geo = 地理位置: {$value}
pos = 座標: {$value}
ext = 擴充: {$ext}
help_tagline = 網路診斷工具
help_show_settings = 按 [{#key}{$key}{/key}] 顯示所有設定
help_show_bindings = 按 [{#key}{$key}{/key}] 顯示所有綁定
help_show_columns = 按 [{#key}{$key}{/key}] 顯示所有欄
help_license = 以 Apache-2.0 授權分發
help_copyright = 版權所有 2022 Trippy 貢獻者
geoip_not_enabled = GeoIp 未啟用
geoip_no_data_for_hop = 第 {$ttl} 跳無 GeoIp 資料
geoip_multiple_data_for_hop = 第 {$ttl} 跳有多個 GeoIp 位置
settings_info = 資訊
settings_tab_tui_title = TUI
settings_tab_trace_title = 追蹤
settings_tab_dns_title = DNS
settings_tab_geoip_title = GeoIp
settings_tab_bindings_title = 綁定
settings_tab_theme_title = 主題
settings_tab_columns_title = 欄
settings_tab_tui_desc = 資料顯示方式設定
settings_tab_trace_desc = 追蹤策略設定
settings_tab_dns_desc = DNS 查詢設定
settings_tab_geoip_desc = GeoIp 設定
settings_tab_bindings_desc = 按鍵綁定設定
settings_tab_theme_desc = 主題顏色設定
settings_tab_columns_desc = TUI 表格欄。按 [{#key}{$c}{/key}] \
  切換欄的顯示和隱藏，使用 [{#key}{$d}{/key}] 和 \
  [{#key}{$u}{/key}] 鍵更改欄的順序。
settings_table_header_setting = 設定
settings_table_header_value = 值
column_host = 主機
column_loss_pct = 封包遺失率
column_snd = 發送
column_recv = 接收
column_last = 最近
column_avg = 平均
column_best = 最佳
column_wrst = 最差
column_stdev = 標準差
column_sts = 狀態
column_jttr = 抖動
column_javg = 均抖
column_jmax = 最大抖
column_jint = 抖動間隔
column_sprt = 來源埠
column_dprt = 目的埠
column_seq = 序列
column_type = 類型
column_code = 代碼
column_nat = NAT
column_fail = 失敗
column_floss = Floss
column_bloss = Bloss
column_floss_pct = Floss%
column_dscp = DSCP
column_ecn = ECN
column_asn = ASN
details_on = ■ 詳情
details_off = □ 詳情
privacy_on = 隱私: {$ttl :integer}
privacy_off = 隱私: -
geoip_no_data_for_hop_addrs = 第 {$ttl} 跳無 GeoIp 資料（{$addrs}）
map_location = {$name} [{$location}]
coordinates = {$latitude :number maximumFractionDigits=4}, \
  {$longitude :number maximumFractionDigits=4}（約 {$radius :integer} \
  公里）
details_index = [{$index :integer}/{$count :integer}]
ms_value = {$value :number minimumFractionDigits=1 maximumFractionDigits=1}
pct_value = {$value :percent minimumFractionDigits=1 maximumFractionDigits=1}
chart_samples = {$samples :integer} ({$zoom :integer}x)
